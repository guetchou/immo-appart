# ============================================================
# Variables d'environnement — Résidence NDOMBI (Docker)
# Copier ce fichier en .env et remplir les valeurs
# Ne jamais committer .env dans git
# ============================================================

# ── Base de données ──────────────────────────────────────
DB_NAME=immo_ndombi
DB_USER=ndombi_user
DB_PASSWORD=GENERER_openssl_rand_base64_24

# ── Strapi secrets (générer avec : openssl rand -base64 32) ──
APP_KEYS=GENERER_1,GENERER_2,GENERER_3,GENERER_4
API_TOKEN_SALT=GENERER
ADMIN_JWT_SECRET=GENERER
TRANSFER_TOKEN_SALT=GENERER
JWT_SECRET=GENERER

# ── API Token Strapi (créer dans l'admin après 1er démarrage)
STRAPI_API_TOKEN=REMPLACER_APRES_CREATION

# ── URLs publiques ────────────────────────────────────────
NEXT_PUBLIC_STRAPI_URL=http://5.196.22.149:1337
NEXT_PUBLIC_SITE_URL=https://residencendombi.lvaclean.cg

# ── Sécurité Next.js ─────────────────────────────────────
PREVIEW_SECRET=GENERER_openssl_rand_hex_32
REVALIDATION_SECRET=GENERER_openssl_rand_hex_32

# ── Email (Resend — optionnel) ────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=reservations@residencendombi.cg
OWNER_EMAIL=residencendombi@gmail.com
